!claudedocs/runtime_logs/grasp_track/g0a_d328/d328_*.png
!claudedocs/runtime_logs/grasp_track/g0a_d330/d330_*.png

# ---- CSV logs ----
*.csv
!claudedocs/*.csv
!claudedocs/runtime_logs/grasp_track/g0a_d328/g0a_d328_final_retest_trials.csv
!claudedocs/runtime_logs/grasp_track/g0a_d330/g0a_d330_cyl_alignment_trials.csv

# ---- Windows-specific (not needed on Linux) ----
*.bat
*.ps1
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ---- Docs folder (PDFs, local docs) ----
docs/

# ---- Sensitive ----
.env
*.key
*.pem

# ---- MCP local config ----
.mcp.json

# ---- MCP servers (cloned repos with venvs) ----
.mcp-servers/

# ---- SSH NUL leftover (Windows->Linux config 잔재 방지) ----
NUL
