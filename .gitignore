# =============================================================================
# RoArm M3 SmolVLA Project - .gitignore
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/

# ---- Virtual Environment ----
.venv/
venv/
env/

# ---- Large Files / Models / Checkpoints ----
models/
outputs/
logs/

# ---- B200 backup / migration (binary checkpoints + Track A logs, NEVER push) ----
b200_backup_*/
*_backup_20*/

# ---- OpenVLA-OFT B200 checkpoint pulls (8GB binary, NEVER push) ----
openvla_oft_b200_pulls/

# ---- WandB / training run artifacts (auto-generated) ----
wandb/

# ---- Datasets (too large for git, recollect per environment) ----
lerobot_dataset/
lerobot_dataset_v*/
lerobot_dataset_stacking_*/
collected_data/
collected_data_*/

# ---- Research runtime datasets (large/generated, never push to GitHub) ----
claudedocs/runtime_logs/**/frames.jsonl
claudedocs/runtime_logs/**/lerobot_dataset*/
claudedocs/runtime_logs/**/metadata_companion*/
claudedocs/runtime_logs/**/debug_extract_frames*/
claudedocs/runtime_logs/**/dataset_freeze_*/
claudedocs/runtime_logs/**/filtered_views_*
claudedocs/runtime_logs/**/label_package_*
claudedocs/runtime_logs/**/postrender_label_validation_*
claudedocs/runtime_logs/**/rl_transition_preflight_*
claudedocs/runtime_logs/**/training_preflight_*
claudedocs/runtime_logs/**/training_smoke_preflight_*
claudedocs/runtime_logs/**/ppo_data_prior_*_logs/**/events.out.tfevents.*
claudedocs/runtime_logs/**/ppo_data_prior_*_logs/**/model_*.pt

# ---- Sim artifacts (regenerable from sim_scripts/) ----
sim_demos_v*/
sim_renders_v*/
sim_v*/

# ---- Debug / inference compare artifacts (machine-specific symlinks + logs) ----
.inference_compare_patched/
compare_inference.stdout
compare_inference.stderr
compare_weights.stdout
compare_weights.stderr

# ---- LeRobot (clone separately) ----
lerobot/

# ---- Binary / Data files (never track) ----
*.npy
*.npz
*.parquet
*.mp4
*.avi
*.mkv
*.pdf

# ---- Isaac Sim / Lab / USD (deprecated, not used in VLA pipeline) ----
isaaclab_roarm/
*.usd
*.usda
*.usdc
.asset_hash

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Temp / Debug / Logs ----
_*.py
!__init__.py
dddd.py
*.tmp
*.bak
*.log
_diag_output.txt
convert_log.txt

# ---- Visualization outputs ----
*.png
*.jpg
*.jpeg
!claudedocs/*.png
!claudedocs/runtime_logs/grasp_track/viz_infra_d324/d324_strict_target_vs_best_attempt.png
!claudedocs/runtime_logs/grasp_track/viz_infra_d324/d324_position_only_tangent_minus1.png
