# =============================================================================
# RoArm M3 SmolVLA Project - .gitignore
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/

# ---- Virtual Environment ----
.venv/
venv/
env/

# ---- Large Files / Models / Checkpoints ----
models/
outputs/
logs/

# ---- B200 backup / migration (binary checkpoints + Track A logs, NEVER push) ----
b200_backup_*/
*_backup_20*/

# ---- OpenVLA-OFT B200 checkpoint pulls (8GB binary, NEVER push) ----
openvla_oft_b200_pulls/

# ---- WandB / training run artifacts (auto-generated) ----
wandb/

# ---- Datasets (too large for git, recollect per environment) ----
lerobot_dataset/
lerobot_dataset_v*/
lerobot_dataset_stacking_*/
collected_data/
collected_data_*/

# ---- Sim artifacts (regenerable from sim_scripts/) ----
sim_demos_v*/
sim_renders_v*/
sim_v*/

# ---- Debug / inference compare artifacts (machine-specific symlinks + logs) ----
.inference_compare_patched/
compare_inference.stdout
compare_inference.stderr
compare_weights.stdout
compare_weights.stderr

# ---- LeRobot (clone separately) ----
lerobot/

# ---- Binary / Data files (never track) ----
*.npy
*.npz
*.parquet
*.mp4
*.avi
*.mkv
*.pdf

# ---- Isaac Sim / Lab / USD (deprecated, not used in VLA pipeline) ----
isaaclab_roarm/
*.usd
*.usda
*.usdc
.asset_hash

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Temp / Debug / Logs ----
_*.py
!__init__.py
dddd.py
*.tmp
*.bak
*.log
_diag_output.txt
convert_log.txt

# ---- Visualization outputs ----
*.png
*.jpg
*.jpeg
!claudedocs/*.png

# ---- CSV logs ----
*.csv
!claudedocs/*.csv

# ---- Windows-specific (not needed on Linux) ----
*.bat
*.ps1
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ---- Docs folder (PDFs, local docs) ----
docs/

# ---- Sensitive ----
.env
*.key
*.pem

# ---- MCP local config ----
.mcp.json

# ---- MCP servers (cloned repos with venvs) ----
.mcp-servers/

# ---- SSH NUL leftover (Windows->Linux config 잔재 방지) ----
NUL
